{
  "name": "rapids",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:add-draft": "node --experimental-strip-types --test tests/add-draft.test.mjs",
    "test:file-meta": "node --experimental-strip-types --test tests/file-meta.test.mjs",
    "test:sniff": "node --experimental-strip-types --test tests/sniff.test.mjs",
    "test:deeplink": "node --experimental-strip-types --test tests/deeplink.test.mjs",
    "test:extension": "node --test tests/extension-handoff.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "gate:content": "node scripts/content-gate.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "framer-motion": "^14.4.0",
    "lucide-react": "^1.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  }
}
